PORT=5001
MONGODB_URI=mongodb://127.0.0.1:27017/fashion-store
JWT_SECRET=change-me
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-too
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Gemini (AI features)
GEMINI_API_KEY=

# Email (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="Store <noreply@example.com>"

# BulkSMSBD Gateway (https://bulksmsbd.net)
SMS_ENABLED=true
SMS_API_KEY=
SMS_SENDER_ID=

# URLs (used for CORS and email links)
PUBLIC_URL=http://localhost:3000
PUBLIC_ADMIN_URL=http://localhost:3001
SERVER_URL=http://localhost:5001

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
